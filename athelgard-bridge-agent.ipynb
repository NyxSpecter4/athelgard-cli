# ─── STEP 2: IMPORTS ───
import smtplib
import requests
import json
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from github import Github
from google.colab import userdata

# ─── STEP 3: SECRETS ───
# Set these in Colab's Secrets Manager (🔑 icon in left sidebar)
GITHUB_TOKEN = userdata.get('GITHUB_TOKEN')      # GitHub personal access token
SENDER_EMAIL = userdata.get('SENDER_EMAIL')      # Gmail address
SENDER_APP_PW = userdata.get('SENDER_APP_PW')    # Gmail App Password (NOT your login password!)
VERCEL_DEPLOY_HOOK = userdata.get('VERCEL_HOOK') # Vercel deploy hook URL

# ─── STEP 4: TOOLS ───

def send_email(to_email: str, subject: str, body: str) -> str:
    """Send handoff email via Gmail SMTP."""
    msg = MIMEMultipart()
    msg['From'] = SENDER_EMAIL
    msg['To'] = to_email
    msg['Subject'] = subject
    msg.attach(MIMEText(body, 'plain'))
    try:
        server = smtplib.SMTP('smtp.gmail.com', 587)
        server.starttls()
        server.login(SENDER_EMAIL, SENDER_APP_PW)
        server.send_message(msg)
        server.quit()
        return "✅ Email sent"
    except Exception as e:
        return f"❌ Email failed: {e}"

def post_github_comment(repo: str, pr: int, comment: str) -> str:
    """Post comment on GitHub PR."""
    try:
        g = Github(GITHUB_TOKEN)
        r = g.get_repo(repo)
        p = r.get_pull(pr)
        p.create_issue_comment(comment)
        return f"✅ Comment posted on {repo}#{pr}"
    except Exception as e:
        return f"❌ GitHub failed: {e}"

def trigger_vercel_deploy(hook_url: str = None) -> str:
    """Trigger Vercel redeploy via deploy hook."""
    url = hook_url or VERCEL_DEPLOY_HOOK
    if not url:
        return "❌ No deploy hook configured"
    try:
        res = requests.post(url, timeout=30)
        return f"✅ Vercel deploy triggered (HTTP {res.status_code})"
    except Exception as e:
        return f"❌ Vercel deploy failed: {e}"

def get_github_repo_status(repo: str) -> dict:
    """Check latest commit and open PRs."""
    try:
        g = Github(GITHUB_TOKEN)
        r = g.get_repo(repo)
        latest = r.get_commits()[0]
        prs = r.get_pulls(state='open')
        return {
            "latest_commit": latest.sha[:7],
            "commit_message": latest.commit.message,
            "open_prs": prs.totalCount,
            "pr_list": [f"#{p.number}: {p.title}" for p in prs[:5]]
        }
    except Exception as e:
        return {"error": str(e)}

# ─── STEP 5: AGENT LOOP ───

class AthelgardBridgeAgent:
    """Autonomous bridge agent for Athelgard ecosystem."""
    
    def __init__(self):
        self.log = []
        
    def log_action(self, action: str, result: str):
        self.log.append({"action": action, "result": result})
        print(f"[{len(self.log)}] {action}: {result}")
        
    def handoff_to_kimi(self, directive: str, kimis_email: str = None) -> str:
        """Send canonical handoff to Kimi via email."""
        subject = "[AGENT HANDOFF] Athelgard — Owl + London Lock"
        body = f"""
🦉 ATHELGARD DIRECTORATE — CANONICAL ROUTE LOCK

{directive}

Status:
- Owl identity: LOCKED
- London range: LOCKED
- SF drone-recon: DECOMMISSIONED

Action Required:
□ Verify Vercel redeployment
□ Confirm LDN-SUP-001 integration
□ Report FPS stability on animated owl

Sent by: Athelgard Bridge Agent (Colab)
"""
        if kimis_email:
            result = send_email(kimis_email, subject, body)
            self.log_action("email_kimi", result)
            return result
        return "❌ No Kimi email configured"
        
    def notify_team(self, repo: str = "NyxSpecter4/athelgard-site", pr: int = None) -> str:
        """Post status update to GitHub PR."""
        status = get_github_repo_status(repo)
        if "error" in status:
            self.log_action("status_check", f"❌ {status['error']}")
            return status['error']
            
        message = f"""
🤖 **Bridge Agent Status Update**

- Latest commit: `{status['latest_commit']}` — {status['commit_message'][:50]}
- Open PRs: {status['open_prs']}
- Owl + London: ✅ LOCKED

Next: Awaiting Vercel redeploy verification.
"""
        if pr:
            result = post_github_comment(repo, pr, message)
            self.log_action("github_notify", result)
            return result
        return "ℹ️ No PR specified — printed status only"
        
    def deploy_now(self) -> str:
        """Trigger Vercel redeploy immediately."""
        result = trigger_vercel_deploy()
        self.log_action("vercel_deploy", result)
        return result
        
    def run_full_sync(self, kimis_email: str = None, repo: str = "NyxSpecter4/athelgard-site", pr: int = None):
        """Run complete sync cycle: check → notify → deploy."""
        print("=" * 50)
        print("🦉 ATHELGARD BRIDGE AGENT — FULL SYNC")
        print("=" * 50)
        
        # 1. Check repo status
        status = get_github_repo_status(repo)
        print(f"\n📊 Repo: {repo}")
        print(f"   Latest: {status.get('latest_commit', 'N/A')}")
        print(f"   Open PRs: {status.get('open_prs', 'N/A')}")
        
        # 2. Send handoff to Kimi
        if kimis_email:
            directive = """DIRECTIVE: Canonical Route Lock
- Mascot: 🦉 Owl (Athelgard identity)
- Range: London (support.london.sim)
- Flow: bountywarz.com → Simli Owl Terminal → Nation Select → London Range → LDN-SUP-001"""
            self.handoff_to_kimi(directive, kimis_email)
        
        # 3. Notify team on GitHub
        if pr:
            self.notify_team(repo, pr)
            
        # 4. Trigger deploy
        self.deploy_now()
        
        print("\n" + "=" * 50)
        print("✅ SYNC COMPLETE")
        print("=" * 50)
        
    def report(self):
        """Print full activity log."""
        print("\n📋 AGENT LOG:")
        for entry in self.log:
            print(f"  • {entry['action']}: {entry['result']}")


